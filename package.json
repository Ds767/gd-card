{
  "name": "gd-card",
  "version": "0.3.0",
  "description": "GDCard — Obsidian 游戏设计卡片插件",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "npm run test:core && npm run test:batch",
    "preview": "esbuild test/preview.ts --bundle --format=esm --platform=node --outfile=test/preview.mjs --alias:obsidian=./test/obsidian-stub.ts --log-level=error && node test/preview.mjs",
    "test:core": "esbuild test/run.ts --bundle --format=esm --platform=node --outfile=test/run.mjs --alias:obsidian=./test/obsidian-stub.ts --log-level=error && node test/run.mjs",
    "test:batch": "esbuild test/batch.ts --bundle --format=esm --platform=node --outfile=test/batch.mjs --alias:obsidian=./test/obsidian-stub.ts --log-level=error && node test/batch.mjs"
  },
  "keywords": [
    "obsidian",
    "game-design"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "js-yaml": "^5.5.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0"
  }
}